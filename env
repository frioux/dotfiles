#!/bin/sh

if [ -r "$HOME/Dropbox/private-dotfiles/env" ]; then
	. "$HOME/Dropbox/private-dotfiles/env"
fi

if [ -r "$HOME/.localdirs" ]; then
	. "$HOME/.localdirs"
	# zsh/envrc/S70_local sources this too, and ~/.localdirs runs
	# `brew shellenv` --- six processes --- so tell it not to bother.
	LOCALDIRS_SOURCED=1
fi

# $0 is this file when zsh sources it; :A resolves the ~/.env symlink and
# :h takes its directory. Only a plain sh has to pay the two forks.
if [ -n "$ZSH_VERSION" ]; then
	DOTFILES=${0:A:h}
else
	DOTFILES="$(dirname "$(readlink "$HOME/.env")")"
fi
export DOTFILES

if [ -d /opt/share/man ] && [ -d /usr/bin/manpath ]; then
	MANPATH=
	export MANPATH="/opt/share/man:$(manpath)"
fi
# zsh dedupes these itself: MANPATH/manpath and PATH/path are tied to
# arrays declared `typeset -U` in zsh/envrc/S10_zshopts. Only a plain sh
# needs the fallback, and it spawns a whole nested zsh to do it.
if [ -z "$ZSH_VERSION" ]; then
	MANPATH="$(zsh -fc "typeset -TU P=$MANPATH p; echo \$P")"
fi

if [ -d /opt/lib ]; then
	export LD_LIBRARY_PATH=/opt/lib
fi

if [ -d "$HOME/.rakudobrew/bin" ]; then
	PATH="$HOME/.rakudobrew/bin:$PATH"
fi

if [ -d "$HOME/go" ]; then
	PATH="$HOME/go/bin:$PATH"
fi

if [ -d "$HOME/local/bin" ]; then
	PATH="$HOME/local/bin:$PATH"
fi

if [ -d /opt/bin ]; then
	PATH="/opt/bin:$PATH"
fi

if [ -d "$HOME/Dropbox/bin" ]; then
	PATH="$HOME/Dropbox/bin:$PATH"
fi

PATH="$DOTFILES/bin:$HOME/bin:$PATH"

if [ -z "$ZSH_VERSION" ]; then
	PATH="$(zsh -fc "typeset -TU P=$PATH p; echo \$P")"
fi

export PATH

if [ -d /opt/include ]; then
	export CFLAGS=-I/opt/include
fi

if [ -d /opt/lib ]; then
	export LDFLAGS=-L/opt/lib
fi

export C=$HOME/code
export WHALEBREW_INSTALL_PATH=/home/frew/bin

export EDITOR=vim
export LESS=-MFRXS
export LESS_TERMCAP_mb=$'\e[1;32m'
export LESS_TERMCAP_md=$'\e[1;32m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[01;33m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;4;31m'
export PAGER=less

export GOVIM_GOPLS_FLAGS=-remote=auto
export GO111MODULE=
export GOPROXY=https://proxy.golang.org
export GOFLAGS=-mod=readonly

if [ -f "$HOME/.dbic.json" ]; then
	export DBIC_TRACE_PROFILE="$HOME/.dbic.json"
fi

if [ "$TERM" = xterm ]; then
	export TERM=xterm-256color
fi

if [ -d "$HOME/code/ziprecruiter" ]; then
	export STARTERVIEW="$HOME/code/ziprecruiter"
elif [ -d "$HOME/ziprecruiter" ]; then
	export STARTERVIEW="$HOME/ziprecruiter"
elif [ -d /var/starterview ]; then
	export STARTERVIEW=/var/starterview
fi

export TZ=America/Los_Angeles
export S_COLORS=never
export QT_AUTO_SCREEN_SCALE_FACTOR=0
