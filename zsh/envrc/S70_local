
# ~/.env already sourced this (see LOCALDIRS_SOURCED there); doing it twice
# means running `brew shellenv` twice per shell.
if [[ -r ~/.localdirs && -z $LOCALDIRS_SOURCED ]]; then
   source ~/.localdirs
fi

if [[ -e ~/.plenv ]]; then
   PATH="$HOME/.plenv/bin:$PATH"
   eval "$(plenv init -)"
else
   function plenv-install() {
      rm ~/perl5 -rf
      git clone git://github.com/tokuhirom/plenv.git ~/.plenv
      git clone git://github.com/tokuhirom/Perl-Build.git ~/.plenv/plugins/perl-build/
      PATH="$HOME/.plenv/bin:$PATH"
      eval "$(plenv init -)"
      plenv install 5.22.0
      plenv global 5.22.0
      plenv install-cpanm
      ~/code/dotfiles/cpan.sh
      plenv rehash
   }
fi
