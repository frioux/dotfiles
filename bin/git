#!/usr/bin/perl

use strict;
use warnings;

no warnings 'uninitialized';

my $real_git = _find_real_git()
   or die "git: no git found on PATH besides $0\n";

$0 = 'git';

my %commit = (
   commit => 1,
   ci     => 1,
);

my %checkout = (
   checkout => 1,
   co       => 1,
);

# git --git-dir=/home/frew/code/dotfiles/.git --no-pager grep -n --no-color foo

exec $real_git unless @ARGV;

my ($precmd, $command, $args) = _parse_args(@ARGV);
my @args = @$args;

if ($commit{$command} && exists $args[0] && $args[0] =~ /^-a|^--all/) {
   my @staged = grep /^M/, split /\0/, `$real_git status -z`;
   if (@staged) {
      my @diff = `$real_git diff --shortstat`;
      if (@diff) {
         print "There are staged changes, are you sure you want to commit all? (y/N) ";
         chomp(my $answer = <STDIN>);
         unless ($answer =~ /^y/i) {
            exit 2;
         }
      }
   }
} elsif ($checkout{$command} && ( grep /^-b|^-B/, @args ) && ( grep /^origin\/(?:release|master)/, @args )) {
   unshift @args, '--no-track';
} elsif ($command eq 'clean' && grep /^-xdff$/, @args) {
   die "Frew your muscle memory is some kind of murder (add another f if you really want it)\n"
} elsif ($command eq 'clean' && grep /^-xdfff$/, @args) {
   s/-xdfff/-xdff/ for @args
} elsif ($command eq 'remote' && $args[0] eq 'add' && @args == 2) {
   @args = ('add', 'origin', $args[-1]);
} elsif ($command eq 'grep' && -f '.git/info/grep-exclude') {

   my @exclude;

   open my $fh, '<', '.git/info/grep-exclude';
   while (<$fh>) {
      chomp;
      next if m/^#/;
      push @exclude, ":!$_";
   }
   close $fh;
   if (1 == grep !m/^-/, @args) {
      push @args, '--', ':./*', @exclude;
   } else {
      # left is stuff that starts with -
      # right is stuff that doesn't (sorta)
      my $left = 1;
      my (@left, @right);
      for my $val (@args) {
         if ($left && $val =~ m/^-/) {
            push @left, $val;
         } else {
            $left = 0;
            push @right, $val;
         }
      }
      @args = (@left, $right[0], '--', @right[1..$#right], @exclude)
   }
}

my @run = ($real_git, @$precmd, $command, @args);
warn join(' ', @run) . "\n" if $ENV{GIT_WRAPPER_DEBUG};
exec @run;

sub _parse_args {
   my @argv = @_;

   my (@precmd, $cmd, @postcmd);

   for my $arg (@argv) {
      if (!$cmd) {
         if ($arg =~ m/^-/) {
            push @precmd, $arg
         } else {
            $cmd = $arg
         }
      } else {
         push @postcmd, $arg
      }
   }

   return \@precmd, $cmd, \@postcmd;
}

# Walk PATH ourselves rather than shelling out to `which -a git`: the backtick
# was a fork on every single git invocation, which doubled the process cost of
# every git command. We identify ourselves by inode rather than by name --- $0
# is whatever path the shell resolved, so a string compare misses a second link
# to this same script on PATH, and picking that one execs into an endless
# ping-pong between the two.
sub _find_real_git {
   my (@self) = stat($0);

   for my $dir (split /:/, ($ENV{PATH} // '')) {
      next unless length $dir;   # empty PATH entry means cwd; don't run git from there
      my $cand = "$dir/git";
      my @st = stat($cand) or next;
      next unless -f _ && -x _;
      next if @self && $st[0] == $self[0] && $st[1] == $self[1];
      return $cand;
   }
   return;
}
