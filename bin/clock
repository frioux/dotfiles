#!/bin/zsh

# Shows the unicode clock face for a time (HH:MM), defaulting to now.
#
# The logic lives in zsh/fn/clock-face so that the prompt can call it as a
# function; this is just the command-line face of it. It used to be sh, but
# sh's printf has no \U on macOS, so it printed "U0001f551" instead of a clock.

fpath=(${${0:A:h}:h}/zsh/fn $fpath)
autoload -Uz clock-face

clock-face "$@"
print -r -- $REPLY
